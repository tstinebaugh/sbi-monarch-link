{
  "manifest_version": 3,
  "name": "SBI Shinsei to Monarch Money Syncer",
  "version": "1.3.0",
  "description": "Sync your SBI Shinsei yen balance to a Monarch Money account, converted to USD at the live rate.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.monarch.com/*",
    "https://api.monarchmoney.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SBI → Monarch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sbishinseibank.co.jp/*",
        "https://*.shinseibank.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
