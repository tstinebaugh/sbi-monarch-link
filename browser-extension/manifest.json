{
  "manifest_version": 3,
  "name": "SBI Shinsei to Monarch Money Syncer",
  "version": "1.2.0",
  "description": "Parses SBI Shinsei JPY balance, converts to USD with live exchange rates, and updates Monarch Money manual asset balance.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://open.er-api.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SBI -> Monarch Link"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sbishinseibank.co.jp/*",
        "https://*.shinseibank.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
